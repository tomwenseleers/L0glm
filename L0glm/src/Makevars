## Native GLM kernels require C++17; R supplies OpenMP flags when available.
## Eigen's SIMD templates trigger ignored-attribute diagnostics.
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -Wno-ignored-attributes -I../inst/include/
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
CXX_STD = CXX17
