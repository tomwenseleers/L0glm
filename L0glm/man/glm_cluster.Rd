dim(Yagg2) # 5000 x 4
matplot(Yagg2 ^ 0.2, type="l", lty=1,
        xlab = "Time index",
        ylab = "Mass cluster ion intensity ^ 0.2",
        main="258 m/z mass channels clustered into 4 aggregate traces\nusing Jensen–Shannon deviance distance")

