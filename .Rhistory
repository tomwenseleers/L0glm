library(sanic)
install.packages("bpcs")
# Simulate data n > p
sim <- simulate_spike_train_np(n_neurons = 50, n_timepoints = 1000, p = 25)
# Simulate data n > p
set.seed(123)
# Set the number of neurons and time bins
n_neurons <- 100
n_bins <- 5000
# Generate spike counts for each neuron using a Poisson process
spike_counts <- rpois(n = n_neurons * n_bins, lambda = 0.1)
spike_counts[spike_counts > 1] <- 1
# Reshape spike counts into a matrix
X <- matrix(spike_counts, ncol = n_neurons)
# Generate binary labels
y <- sample(c(0, 1), n_bins, replace = TRUE)
# Simulate data p > n
sim <- simulate_spike_train()
X <- sim$X
y <- sim$y
plot(X, y)
X_t <- t(X)
y_t <- y
# Plot the transposed data
plot(X_t, y_t)
Plot(X, y)
plot(X, y)
# Simulate data p > n
sim_t <- simulate_spike_train(n = 1000, p = 100)
dim(X)
dim(y)
